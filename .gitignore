# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Runtime data: everything under data/ is regenerated by `./run.sh`, including
# the full 24 h synthetic file (11 MB), the netCDF grids and the SQLite index.
# Only the small one-hour sample is committed -- it is documentation of the raw
# format, not scratch space, and the tests can run against it offline.
data/*
!data/samples/
data/samples/*
!data/samples/synthetic_cl31_1h.dat
!data/samples/synthetic_cl31_1h_truth.json

